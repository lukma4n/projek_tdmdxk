# Konfigurasi frontend (Vite). Salin ke `.env` lalu sesuaikan.

# Base URL API. Di produksi frontend dilayani satu origin dengan API → cukup "/api".
VITE_API_URL=/api

# Pakai data mock (dev saja).
VITE_USE_MOCK=false

# URL publik untuk link & QR self-check STNK/BPKB (mis. /cek?engine_number=...).
# Kosongkan → fallback ke window.location.origin (jalan tanpa konfigurasi di dev).
# Produksi: isi domain publik, mis. https://dxk-ketapang.co.id
VITE_PUBLIC_URL=

# Nomor WhatsApp dealer untuk tombol "Request via WhatsApp" di halaman /cek.
# Format internasional tanpa + / 0 (mis. 6281234567890). Kosong → tombol disembunyikan.
VITE_DEALER_WA_PHONE=
