# ============================================================
# Template ENV PRODUKSI — DXK Operation System
# Salin ke `api/.env` di server, lalu isi nilai nyata.
# JANGAN commit file .env yang sudah berisi secret.
# ============================================================

# --- Database (SQLite, resmi) ---
# Path absolut disarankan di produksi, mis: file:/var/lib/dxk/dev.db
DATABASE_URL=file:./dev.db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# WAJIB string acak panjang. Generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# --- Runtime ---
NODE_ENV=production
PORT=3001

# --- CORS / Frontend ---
# Origin frontend produksi yang sebenarnya (boleh dipisah koma untuk beberapa origin).
FRONTEND_URL=https://app.domain-anda.com
ALLOWED_ORIGINS=https://app.domain-anda.com

# Satu origin publik untuk tautan {link_cek} di pesan WhatsApp STNK/BPKB.
# WAJIB diisi di produksi: kalau kosong, sistem jatuh ke FRONTEND_URL — dan
# FRONTEND_URL boleh berisi beberapa origin dipisah koma, yang akan menghasilkan
# tautan rusak di pesan yang sudah terlanjur sampai ke konsumen.
PUBLIC_URL=https://app.domain-anda.com

# WhatsApp gateway (Wablas) untuk follow-up KPB/STNK/BPKB.
# Host berbeda per akun (texas/solo/jogja/...) dan token TIDAK berlaku lintas host.
# Kosongkan semuanya untuk menonaktifkan pengiriman WhatsApp.
WABLAS_HOST=https://texas.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=

# Batas jumlah konsumen yang boleh dikirimi WhatsApp per hari (global, lintas
# modul KPB/STNK/BPKB). Melindungi nomor gateway dari pemblokiran WhatsApp.
# Kosong = 30.
WHATSAPP_DAILY_LIMIT=30
