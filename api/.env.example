# DB resmi = SQLite. Jangan ganti ke Postgres tanpa rencana migrasi terpisah
# (backupService & ~89 filter search bergantung pada perilaku SQLite).
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379

# WAJIB diganti di produksi dengan string acak panjang (mis. `openssl rand -hex 32`).
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# Set `production` saat deploy.
NODE_ENV=development
PORT=3001

# URL frontend untuk CORS. Di produksi isi origin nyata (boleh dipisah koma).
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Satu origin publik untuk tautan {link_cek} di pesan WhatsApp STNK/BPKB.
# Kosong = jatuh ke FRONTEND_URL. Di produksi WAJIB diisi, karena FRONTEND_URL
# boleh berisi beberapa origin dipisah koma dan itu menghasilkan tautan rusak.
PUBLIC_URL=http://localhost:5173

# WhatsApp gateway (Wablas) untuk follow-up KPB/STNK/BPKB.
# Host berbeda per akun (texas/solo/jogja/...) dan token TIDAK berlaku lintas host.
# Kosongkan semuanya untuk menonaktifkan pengiriman WhatsApp.
WABLAS_HOST=https://texas.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=

# Batas jumlah konsumen yang boleh dikirimi WhatsApp per hari (global, lintas
# modul KPB/STNK/BPKB). Melindungi nomor gateway dari pemblokiran WhatsApp.
# Kosong = 30.
WHATSAPP_DAILY_LIMIT=30
